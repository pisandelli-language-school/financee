{
  "$description": "Custom theme tokens for Financee",
  "customs": {
    "logo": {
      "fill": {
        "$value": "#1c2f48"
      }
    },
    "chart": {
      "financial": {
        "income": { "$value": "#26B86A" },
        "expense": { "$value": "#EF5B62" },
        "net": { "$value": "#2F6FED" }
      },
      "delinquency": {
        "high": { "$value": "#EF5B62" },
        "medium": { "$value": "#F0B654" },
        "low": { "$value": "#94A3B8" }
      },
      "text": { "$value": "#171717" },
      "muted": { "$value": "#737373" },
      "grid": { "$value": "#e5e5e5" }
    }
  },
  "themes": {
    "dark": {
      "logo": {
        "fill": {
          "$value": "#FFFFFF"
        }
      },
      "chart": {
        "financial": {
          "income": { "$value": "#89d590" },
          "expense": { "$value": "#dc8d93" },
          "net": { "$value": "#4895f6" }
        },
        "delinquency": {
          "high": { "$value": "#dc8d93" },
          "medium": { "$value": "#ff9c16" },
          "low": { "$value": "#9ab6cd" }
        },
        "text": { "$value": "#fafafa" },
        "muted": { "$value": "#a3a3a3" },
        "grid": { "$value": "#404040" }
      },
      "state": {
        "warning": {
          "surface": {
            "$value": "#B38A2C1C"
          },
          "surface-hover": {
            "$value": "#B38A2C2A"
          },
          "border": {
            "$value": "#D0A33D52"
          },
          "on-surface": {
            "$value": "#E7D7B0"
          }
        }
      },
      "border": {
        "default": {
          "$value": "{color.gray.100}"
        }
      }
    },
    "darker": {
      "logo": {
        "fill": {
          "$value": "#FFFFFF"
        }
      },
      "chart": {
        "financial": {
          "income": { "$value": "#61c66a" },
          "expense": { "$value": "#d0656d" },
          "net": { "$value": "#0e69f1" }
        },
        "delinquency": {
          "high": { "$value": "#d0656d" },
          "medium": { "$value": "#ff9c16" },
          "low": { "$value": "#769ebc" }
        },
        "text": { "$value": "#fafafa" },
        "muted": { "$value": "#737373" },
        "grid": { "$value": "#404040" }
      },
      "state": {
        "warning": {
          "surface": {
            "$value": "#B38A2C24"
          },
          "surface-hover": {
            "$value": "#B38A2C33"
          },
          "border": {
            "$value": "#D0A33D5E"
          },
          "on-surface": {
            "$value": "#F0E0B8"
          }
        }
      },
      "border": {
        "default": {
          "$value": "{color.gray.100}"
        }
      }
    }
  }
}
