        }
      }
    },
    "darker": {
      "logo": {
        "fill": {
          "$value": "#FFFFFF"
        }
      },
      "state": {
        "warning": {
          "surface": {
            "$value": "#B38A2C24"
          },
          "surface-hover": {
            "$value": "#B38A2C33"
